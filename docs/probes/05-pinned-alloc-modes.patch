+// Pinned host allocation properties, for measuring the transport-side value of the
+// allocation itself with a host-resident KV cache. Opt-in and mutually exclusive;
+// with none of them set this is upstream cudaMallocHost verbatim.
+//
+//   GGML_CUDA_PINNED_WC     write-combined: uncached on the CPU side, so host writes
+//                           stream out through the write-combine buffers and device
+//                           reads over PCIe do not snoop. Correct only because the
+//                           steady-state pattern is host-write / device-read; any
+//                           host *read* of the body (state serialization, prompt
+//                           cache, rollback, defrag) becomes uncached and very slow.
+//   GGML_CUDA_PINNED_HUGE   explicitly ask for transparent huge pages.
+//   GGML_CUDA_PINNED_NOHUGE explicitly refuse them, which is what makes the huge-page
+//                           question measurable on a host whose THP policy is already
+//                           "always": the delta against the default arm is what the
+//                           2 MiB backing is worth.
+enum ggml_cuda_host_alloc_kind {
+    GGML_CUDA_HOST_ALLOC_DEFAULT = 0,
+    GGML_CUDA_HOST_ALLOC_WC,
+    GGML_CUDA_HOST_ALLOC_HUGE,
+    GGML_CUDA_HOST_ALLOC_NOHUGE,
+};
+
+static ggml_cuda_host_alloc_kind ggml_cuda_host_alloc_mode() {
+    static const ggml_cuda_host_alloc_kind kind = []() {
+        if (getenv("GGML_CUDA_PINNED_WC")     != nullptr) return GGML_CUDA_HOST_ALLOC_WC;
+        if (getenv("GGML_CUDA_PINNED_HUGE")   != nullptr) return GGML_CUDA_HOST_ALLOC_HUGE;
+        if (getenv("GGML_CUDA_PINNED_NOHUGE") != nullptr) return GGML_CUDA_HOST_ALLOC_NOHUGE;
+        return GGML_CUDA_HOST_ALLOC_DEFAULT;
+    }();
+    return kind;
+}
+
+// Allocations that were registered rather than allocated by CUDA, and therefore need
+// cudaHostUnregister + free instead of cudaFreeHost.
+static std::mutex                ggml_cuda_host_registered_mutex;
+static std::unordered_set<void *> ggml_cuda_host_registered;
+
 static void ggml_backend_cuda_host_buffer_free_buffer(ggml_backend_buffer_t buffer) {
-    CUDA_CHECK(cudaFreeHost(buffer->context));
+    void * ptr = buffer->context;
+
+    bool registered = false;
+    {
+        std::lock_guard<std::mutex> lock(ggml_cuda_host_registered_mutex);
+        registered = ggml_cuda_host_registered.erase(ptr) > 0;
+    }
+
+    if (registered) {
+        CUDA_CHECK(cudaHostUnregister(ptr));
+        free(ptr);
+        return;
+    }
+
+    CUDA_CHECK(cudaFreeHost(ptr));
 }
 
+#ifdef __linux__
+// Page-aligned allocation with an explicit transparent-huge-page advice, pinned
+// afterwards with cudaHostRegister. Returns nullptr on any failure so the caller can
+// fall back to the plain path.
+static void * ggml_cuda_host_malloc_advised(size_t size, int advice) {
+    const size_t huge = 2ull * 1024 * 1024;
+    const size_t padded = (size + huge - 1) / huge * huge;
+
+    void * ptr = nullptr;
+    if (posix_memalign(&ptr, huge, padded) != 0 || ptr == nullptr) {
+        return nullptr;
+    }
+
+    if (madvise(ptr, padded, advice) != 0) {
+        GGML_LOG_DEBUG("%s: madvise(%d) failed: %s\n", __func__, advice, strerror(errno));
+        free(ptr);
+        return nullptr;
+    }
+
+    // Fault the pages in before registering so the advice is applied at fault time.
+    memset(ptr, 0, padded);
+
+    cudaError_t err = cudaHostRegister(ptr, padded, cudaHostRegisterPortable);
+    if (err != cudaSuccess) {
+        (void)cudaGetLastError();
+        GGML_LOG_DEBUG("%s: cudaHostRegister of %.2f MiB failed: %s\n", __func__,
+                       padded / 1024.0 / 1024.0, cudaGetErrorString(err));
+        free(ptr);
+        return nullptr;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(ggml_cuda_host_registered_mutex);
+        ggml_cuda_host_registered.insert(ptr);
+    }
+
+    return ptr;
+}
+#endif // __linux__
+
 static void * ggml_cuda_host_malloc(size_t size) {
     if (getenv("GGML_CUDA_NO_PINNED") != nullptr) {
         return nullptr;
     }
 
+    const ggml_cuda_host_alloc_kind kind = ggml_cuda_host_alloc_mode();
+
+#ifdef __linux__
+    if (kind == GGML_CUDA_HOST_ALLOC_HUGE || kind == GGML_CUDA_HOST_ALLOC_NOHUGE) {
+        void * ptr = ggml_cuda_host_malloc_advised(
+            size, kind == GGML_CUDA_HOST_ALLOC_HUGE ? MADV_HUGEPAGE : MADV_NOHUGEPAGE);
+        if (ptr != nullptr) {
+            return ptr;
+        }
+        // fall through to the plain pinned path
+    }
+#endif // __linux__
+
     void * ptr = nullptr;
-    cudaError_t err = cudaMallocHost((void **) &ptr, size);
+    cudaError_t err = kind == GGML_CUDA_HOST_ALLOC_WC
+        ? cudaHostAlloc((void **) &ptr, size, cudaHostAllocWriteCombined)
+        : cudaMallocHost((void **) &ptr, size);
     if (err != cudaSuccess) {
         // clear the error
         (void)cudaGetLastError();
